{
  "name": "sendscore/sendscore",
  "description": "Check a newsletter email before it goes out. A typed wrapper around the SendScore CLI.",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": ">=8.1",
    "ext-hash": "*",
    "ext-json": "*",
    "ext-openssl": "*",
    "ext-zlib": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5 || ^11.0"
  },
  "autoload": {
    "psr-4": {
      "SendScore\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "SendScore\\Tests\\": "tests/"
    }
  },
  "config": {
    "platform": {
      "php": "8.1.0"
    }
  }
}
